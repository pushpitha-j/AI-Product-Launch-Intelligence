# Copy this file to .env and fill in your keys.
# You need ONE LLM key (OpenAI or Google Gemini) plus the Firecrawl key.

# Option A – Google Gemini (free tier, key from aistudio.google.com)
GOOGLE_API_KEY=

# Option B – OpenAI (needs credit on platform.openai.com)
OPENAI_API_KEY=

# Web search and scraping (free plan at firecrawl.dev)
FIRECRAWL_API_KEY=

# Optional overrides
# LLM_PROVIDER=gemini
# GEMINI_MODEL=gemini-flash-lite-latest
# OPENAI_MODEL=gpt-5.4-mini
